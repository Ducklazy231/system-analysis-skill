sequenceDiagram
    autonumber
    actor Staff
    participant App as Application
    participant DB as Database
    actor Approver

    Staff->>App: Submit request
    App->>App: Validate required data
    alt Request invalid
        App-->>Staff: Show validation errors
    else Request valid
        App->>DB: Save Pending Approval
        DB-->>App: Request ID
        App-->>Staff: Show submission result
        Approver->>App: Open request
        App->>DB: Fetch latest record state
        DB-->>App: Current status and details
        App-->>Approver: Show request
        Approver->>App: Select Approve or Reject
        App->>App: Validate permission and status

        alt Unauthorized or status changed
            App-->>Approver: Reject action with reason
        else Approve
            App->>DB: Save Approved and approver
            DB-->>App: Update succeeded
            App-->>Approver: Show Approved
        else Reject
            App->>App: Check rejection reason
            alt Rejection reason missing
                App-->>Approver: Require reason
            else Reason provided
                App->>DB: Save Rejected and reason
                DB-->>App: Update succeeded
                App-->>Approver: Show Rejected
            end
        end
    end
