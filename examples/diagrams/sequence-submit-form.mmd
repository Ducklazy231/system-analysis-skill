sequenceDiagram
    autonumber
    actor User
    participant FE as Frontend
    participant API as Backend API
    participant DB as Database

    User->>FE: Fill form and click Submit
    rect rgb(239, 246, 255)
        FE->>API: POST /requests + payload
        API->>API: Validate fields and permissions
    end

    alt Validation fails
        API-->>FE: Field errors
        FE-->>User: Show validation errors
    else Validation passes
        API->>DB: Insert request as Draft
        alt Database write fails
            DB-->>API: Database error
            API-->>FE: Failure response + request reference
            FE-->>User: Show failure and retry option
        else Save succeeds
            DB-->>API: Request ID
            rect rgb(240, 253, 244)
                API-->>FE: 201 Created + Request ID
                FE-->>User: Show submitted request reference
            end
        end
    end
